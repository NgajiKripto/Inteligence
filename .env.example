# ===========================================
# MemeCoin Intelligence - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your API keys

# ============= LLM Configuration =============
# Supports OpenAI, DeepSeek, Qwen, or any OpenAI-compatible API
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ============= Blockchain RPC =============
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# ============= On-Chain Analysis =============
# Helius (Solana enhanced RPC - recommended for holder/contract analysis)
HELIUS_API_KEY=
# Solscan API
SOLSCAN_API_KEY=
# GMGN (rug ratio, bundler rate, wash trading detection - optional)
GMGN_API_KEY=

# ============= DEX & Price Data =============
# DexScreener (free, no key needed for basic)
DEXSCREENER_API_URL=https://api.dexscreener.com/latest
# Birdeye (Solana token data - optional, for price history)
BIRDEYE_API_KEY=
# Jupiter (Solana DEX aggregator)
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ============= Social Media =============
# Twitter/X API Bearer Token (for sentiment analysis)
TWITTER_BEARER_TOKEN=
# Telegram Bot Token (for group monitoring)
TELEGRAM_BOT_TOKEN=
# Reddit API (for r/cryptocurrency, r/solana monitoring)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ============= Analysis Settings =============
SENTIMENT_UPDATE_INTERVAL=60
WHALE_ALERT_THRESHOLD_SOL=100
WHALE_ALERT_THRESHOLD_USD=50000
MAX_TRACKED_TOKENS=50

# ============= Simulation Settings =============
SIMULATION_MAX_AGENTS=100
SIMULATION_MAX_ROUNDS=20
AGENT_TEMPERATURE=0.7

# ============= Risk Thresholds =============
RISK_SCORE_HIGH=0.7
RISK_SCORE_CRITICAL=0.9

# ============= Server Settings =============
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=True
SECRET_KEY=change-this-to-random-string

# ============= Security =============
# API authentication key (leave empty to disable auth in dev mode)
# When set, all mutating endpoints require X-API-Key header
API_AUTH_KEY=
# Allowed CORS origins (comma-separated, used in production)
CORS_ORIGINS=http://localhost:3000
